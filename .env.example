# Copy this to .env and fill in your values.
# NEVER commit .env to git.

# ========== REQUIRED ==========

# Long random string for session signing.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Neon PostgreSQL connection URL (shared with web app)
# DATABASE_URL=postgresql://user:password@host/dbname

# ========== ADMIN PASSWORDS ==========
# Set passwords for admin accounts. Used once at seed time (app startup).
# If not set, admin will not be able to log in.
ADMIN001_PASSWORD=replace-with-secure-password
ADMIN002_PASSWORD=replace-with-secure-password

# ========== OPTIONAL ==========

# Garage owner phone number (used by both web and desktop apps)
# Seeded into the admins table
GARAGE_OWNER_PHONE=9898135662

# Set to "true" only during local development
# FLASK_DEBUG=false

# Optional: Override database paths (uncomment if needed)
# GARAGE_DATABASE=/var/data/garage.db
# DATA_DIR=/var/data
