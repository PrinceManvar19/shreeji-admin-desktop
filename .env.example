# Copy this to .env and fill in your values.
# NEVER commit .env to git.

# ========== REQUIRED ==========

# Long random string for session signing.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Neon PostgreSQL connection URL (shared with web app)
# DATABASE_URL=postgresql://user:password@host/dbname

# Admin email for password-based login (desktop only)
# This email address will be seeded into admin_users table on first run
ADMIN_EMAIL=admin@example.com

# ========== OPTIONAL ==========

# Pre-set admin password (if not set, a secure random password is generated at startup)
# Only set this if you want to hardcode a password - otherwise let it auto-generate
# ADMIN_DEFAULT_PASSWORD=

# Garage owner phone number (used by both web and desktop apps)
# Seeded into the admins table
GARAGE_OWNER_PHONE=9898135662

# Admin PIN for web app secondary verification (web app only)
# If set, web admins must enter this PIN on login in addition to their ID
# WEB_ADMIN_PIN=1234

# Set to "true" only during local development
# FLASK_DEBUG=false

# ========== DEPRECATED ==========
# The following are kept for reference but are no longer actively used:

# Admin email OTP login (currently disabled - use password login instead)
# ADMIN_OTP_EMAIL=replace-with-admin-email@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=1
# SMTP_USERNAME=replace-with-smtp-username
# SMTP_PASSWORD=replace-with-smtp-app-password
# SMTP_FROM_EMAIL=replace-with-sender-email@example.com

# Optional: Override database paths (uncomment if needed)
# GARAGE_DATABASE=/var/data/garage.db
# DATA_DIR=/var/data
